GEMINI_API_KEY=put-your-key-here
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GEMINI_MODEL=gemini-3.8-flash
# Discord. Default webhook: used for teams without their own webhook, and for
# events that belong to no team (Reset demo, nothing-to-clear, failures).
DISCORD_WEBHOOK_URL=

# How long an API call waits for Discord before answering "pending" (seconds).
DISCORD_WAIT_SECONDS=3
DISCORD_TIMEOUT_SECONDS=8
